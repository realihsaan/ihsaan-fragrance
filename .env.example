# Local MySQL store database. Run `npm run db:setup` to create the database user
# and fill these settings in the ignored .env.local file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ihsaan_fragrance
MYSQL_USER=ihsaan_app
MYSQL_PASSWORD=generated-by-db-setup

# Local administrator credentials are generated by `npm run db:setup`.
LOCAL_ADMIN_EMAIL=admin@ihsaan.local
LOCAL_ADMIN_PASSWORD=generated-by-db-setup

# Optional card checkout. Without these values, checkout uses Cash on Delivery.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3001
PORT=3001
STRIPE_ALLOWED_COUNTRIES=PK

# SMTP Email Configuration (for order confirmations, password reset, and contact inquiries)
# Google Workspace / Gmail SMTP Configuration for ehsaanali.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@ehsaanali.com
SMTP_PASSWORD=
SMTP_FROM="Maison Ihsaan Ali" <orders@ehsaanali.com>

# Google OAuth 2.0 Sign-In Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
